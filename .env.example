# Object Storage Configuration (Deployment-Ready Alternative to AWS S3)
# Options:
# - "postgres" (Recommended Default: stores uploads in PostgreSQL stored_objects table - zero extra accounts)
# - "s3"       (Cloudflare R2, Backblaze B2, Supabase Storage S3, MinIO, or AWS S3 via S3_ENDPOINT_URL)
# - "local"    (Local filesystem directory)
STORAGE_BACKEND="postgres"
S3_ENDPOINT_URL=""
LOCAL_STORAGE_DIR=".storage"

# S3-Compatible Credentials (only needed if STORAGE_BACKEND="s3")
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET="atlas-documents"

# Google Gemini Free Tier Configuration (100% Free - No Credit Card Required)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY="your-free-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"

# Hugging Face Open-Source Embedding Configuration (Free & Local via FastEmbed)
HF_EMBED_MODEL="BAAI/bge-small-en-v1.5"
EMBED_DIM=384

# Pinecone Vector Database Configuration
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_INDEX_NAME="atlas-enterprise-ai-index"
PINECONE_CLOUD="aws"
PINECONE_REGION="us-east-1"
PINECONE_READY_TIMEOUT=180

# PostgreSQL Database Configuration
DATABASE_URL="your-postgresql-database-url"

# RIUS Observability Configuration (Privacy-first)
RIUS_API_KEY="your-rius-api-key"
RIUS_SERVICE_NAME="atlas-ai-enterprise"
RIUS_DISABLED=false
RIUS_CAPTURE_CONTENT=false

# FastAPI / CORS / JWT Auth / RAG Settings
CORS_ORIGINS="http://127.0.0.1:8000,http://localhost:8000"
JWT_SECRET_KEY="replace-with-a-random-32-char-secret-key"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=1440
HITL_ENABLED=true
MIN_RELEVANCE=0.25
MEMORY_TURNS=6
